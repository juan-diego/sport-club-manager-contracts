{
  "name": "@sport-club-manager/contracts",
  "version": "0.1.0-dev.20260714070040877",
  "description": "Shared contracts and domain models for the Sport Club Manager application.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:source-dependencies": "node scripts/check-source-dependencies.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "spell": "cspell --no-progress --no-summary src README.md docs .agent",
    "api:check": "npm run build && api-extractor run",
    "package:check": "npm run build && node scripts/verify-package.mjs",
    "package:smoke": "npm run build && node scripts/smoke-package.mjs",
    "security": "npm audit --audit-level=high",
    "quality": "npm run typecheck && npm run check:source-dependencies && npm run lint && npm run test && npm run spell && npm run api:check && npm run package:check && npm run package:smoke && npm run security",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "rxjs": "~7.8.0"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.9",
    "cspell": "9.2.1",
    "eslint": "9.35.0",
    "rxjs": "~7.8.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "5.1.0"
  }
}
